{
  "name": "@cvjson/api",
  "version": "0.1.0",
  "private": true,
  "description": "CVJSON hosted resume parsing API, running on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute cvjson --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute cvjson --local --file=./schema.sql"
  },
  "dependencies": {
    "cvjson": "*",
    "unpdf": "^0.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.99.0"
  }
}
